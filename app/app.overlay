/ {
    chosen {
        zephyr,code-partition = &code_partition;
    };

    aliases {
        mux0 = &cd4067_0;
        mux1 = &cd4067_1;
        mux2 = &cd4067_2;
        mux3 = &cd4067_3;
        mux4 = &cd4067_4;
    };

    cd4067_0: cd4067_mux {
        compatible = "vnd,cd4067-gpio-mux";
        status = "okay";
        select-gpios = <&gpiob 5 GPIO_ACTIVE_HIGH>,
                       <&gpiob 4 GPIO_ACTIVE_HIGH>,
                       <&gpiob 10 GPIO_ACTIVE_HIGH>,
                       <&gpioa 8 GPIO_ACTIVE_HIGH>;
        sig-gpios = <&gpioa 1 GPIO_ACTIVE_HIGH>;
    };

    cd4067_1: cd4067_mux_1 {
        compatible = "vnd,cd4067-gpio-mux";
        status = "okay";
        select-gpios = <&gpiob 5 GPIO_ACTIVE_HIGH>,
                       <&gpiob 4 GPIO_ACTIVE_HIGH>,
                       <&gpiob 10 GPIO_ACTIVE_HIGH>,
                       <&gpioa 8 GPIO_ACTIVE_HIGH>;
        sig-gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>;
    };

    cd4067_2: cd4067_mux_2 {
        compatible = "vnd,cd4067-gpio-mux";
        status = "okay";
        select-gpios = <&gpiob 5 GPIO_ACTIVE_HIGH>,
                       <&gpiob 4 GPIO_ACTIVE_HIGH>,
                       <&gpiob 10 GPIO_ACTIVE_HIGH>,
                       <&gpioa 8 GPIO_ACTIVE_HIGH>;
        sig-gpios = <&gpioa 4 GPIO_ACTIVE_HIGH>;
    };

    cd4067_3: cd4067_mux_3 {
        compatible = "vnd,cd4067-gpio-mux";
        status = "okay";
        select-gpios = <&gpiob 5 GPIO_ACTIVE_HIGH>,
                       <&gpiob 4 GPIO_ACTIVE_HIGH>,
                       <&gpiob 10 GPIO_ACTIVE_HIGH>,
                       <&gpioa 8 GPIO_ACTIVE_HIGH>;
        sig-gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>;
    };

    cd4067_4: cd4067_mux_4 {
        compatible = "vnd,cd4067-gpio-mux";
        status = "okay";
        select-gpios = <&gpiob 5 GPIO_ACTIVE_HIGH>,
                       <&gpiob 4 GPIO_ACTIVE_HIGH>,
                       <&gpiob 10 GPIO_ACTIVE_HIGH>,
                       <&gpioa 8 GPIO_ACTIVE_HIGH>;
        sig-gpios = <&gpioc 1 GPIO_ACTIVE_HIGH>;
    };
};

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        code_partition: partition@0 {
            label = "image-0";
            reg = <0x00000000 0x00080000>;
        };
    };
};

&i2c1 {
    status = "okay";

    pca9685_40: pca9685@40 {
        status = "okay";
        compatible = "nxp,pca9685-pwm";
        reg = <0x40>;
        #pwm-cells = <3>;
    };

    pca9685_41: pca9685@41 {
        status = "okay";
        compatible = "nxp,pca9685-pwm";
        reg = <0x41>;
        #pwm-cells = <3>;
    };

    pca9685_42: pca9685@42 {
        status = "okay";
        compatible = "nxp,pca9685-pwm";
        reg = <0x42>;
        #pwm-cells = <3>;
    };

    pca9685_43: pca9685@43 {
        status = "okay";
        compatible = "nxp,pca9685-pwm";
        reg = <0x43>;
        #pwm-cells = <3>;
    };

    pca9685_44: pca9685@44 {
        status = "okay";
        compatible = "nxp,pca9685-pwm";
        reg = <0x44>;
        #pwm-cells = <3>;
    };

    pca9685_45: pca9685@45 {
        status = "okay";
        compatible = "nxp,pca9685-pwm";
        reg = <0x45>;
        #pwm-cells = <3>;
    };

    pca9685_46: pca9685@46 {
        status = "okay";
        compatible = "nxp,pca9685-pwm";
        reg = <0x46>;
        #pwm-cells = <3>;
    };

    pca9685_47: pca9685@47 {
        status = "okay";
        compatible = "nxp,pca9685-pwm";
        reg = <0x47>;
        #pwm-cells = <3>;
    };

    pca9685_48: pca9685@48 {
        status = "okay";
        compatible = "nxp,pca9685-pwm";
        reg = <0x48>;
        #pwm-cells = <3>;
    };

    pca9685_49: pca9685@49 {
        status = "okay";
        compatible = "nxp,pca9685-pwm";
        reg = <0x49>;
        #pwm-cells = <3>;
    };

    pca9685_4a: pca9685@4a {
        status = "okay";
        compatible = "nxp,pca9685-pwm";
        reg = <0x4a>;
        #pwm-cells = <3>;
    };

    pca9685_4b: pca9685@4b {
        status = "okay";
        compatible = "nxp,pca9685-pwm";
        reg = <0x4b>;
        #pwm-cells = <3>;
    };

    pca9685_4c: pca9685@4c {
        status = "okay";
        compatible = "nxp,pca9685-pwm";
        reg = <0x4c>;
        #pwm-cells = <3>;
    };
};

&usart1 {
    pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
    pinctrl-names = "default";
    current-speed = <1000000>;
    status = "okay";
};

&usart2 {
    current-speed = <1000000>;
};

&usbotg_fs {
    pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
    pinctrl-names = "default";
    status = "okay";
};

&spi1 {
    status = "disabled";
};

&sdmmc1 {
    pinctrl-0 = <&sdio_cmd_pa6 &sdio_ck_pb15
                 &sdio_d0_pc8 &sdio_d1_pc9
                 &sdio_d2_pc10 &sdio_d3_pc11>;
    pinctrl-names = "default";
    bus-width = <4>;
    clk-div = <1>;
    status = "okay";
    disk-name = "SD";
};

/ {
    usb_midi: usb_midi {
        compatible = "zephyr,midi2-device";
        status = "okay";
        #address-cells = <1>;
        #size-cells = <1>;
        label = "Bassline Junkie Interface";

        midi_in_out@0 {
            reg = <0 1>;
            protocol = "midi1-up-to-128b";
            label = "MIDI";
        };
    };
};
