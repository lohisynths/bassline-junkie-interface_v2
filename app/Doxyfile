PROJECT_NAME           = "Bassline Junkie Interface"
PROJECT_BRIEF          = "Zephyr firmware for the Nucleo-F411RE with a USB MIDI 2.0 device, an app-owned USART1 MIDI transport shared with the Raspberry Pi DSP, CD4067 mux scanning, PCA9685 LED outputs, flash-backed 128-slot presets, startup-slot metadata, a reserved MIDI CC preset-dump request path, and UI_BLOCK-based ADSR/FLT/LED_DISP/LFO/MOD/OSC control surfaces."
OUTPUT_DIRECTORY       = app/docs/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
USE_MDFILE_AS_MAINPAGE = app/docs/mainpage.md

INPUT                  = README.md \
                         app/docs/mainpage.md \
                         app/src/blocks/ADSR.h \
                         app/src/blocks/FLT.h \
                         app/src/blocks/LED_DISP.h \
                         app/src/blocks/LFO.h \
                         app/src/blocks/MOD.h \
                         app/src/blocks/MOD.cpp \
                         app/src/blocks/OSC.h \
                         app/src/blocks/OSC.cpp \
                         app/src/blocks/UI_BLOCK.h \
                         app/src/blocks/UI_BLOCK.cpp \
                         app/src/Button.h \
                         app/src/Button.cpp \
                         app/src/EEPROM.h \
                         app/src/EEPROM.cpp \
                         app/src/Encoder.h \
                         app/src/Encoder.cpp \
                         app/src/GPIO.h \
                         app/src/GPIO.cpp \
                         app/src/InputController.h \
                         app/src/InputController.cpp \
                         app/src/Knob.h \
                         app/src/Knob.cpp \
                         app/src/LEDS.h \
                         app/src/LEDS.cpp \
                         app/src/Preset.h \
                         app/src/Preset.cpp \
                         app/src/PresetDumpRequestListener.h \
                         app/src/PresetDumpRequestListener.cpp \
                         app/src/PresetSnapshot.h \
                         app/src/MUX.h \
                         app/src/MUX.cpp \
                         app/src/utils.h \
                         app/src/utils.cpp \
                         app/src/USB_MIDI.h \
                         app/src/USB_MIDI.cpp \
                         app/src/usb_midi_init.h \
                         app/src/usb_midi_init.c \
                         app/src/main.cpp \
                         app/app.overlay \
                         cd4067/include/zephyr/drivers/mux/cd4067.h
FILE_PATTERNS          = *.md \
                         *.overlay \
                         *.c \
                         *.h \
                         *.cpp
RECURSIVE              = NO
EXCLUDE_SYMBOLS        = cd4067_driver_api

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO

QUIET                  = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES

MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
INLINE_INFO            = YES
SORT_MEMBER_DOCS       = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
HAVE_DOT               = NO
