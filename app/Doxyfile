PROJECT_NAME           = "Bassline Junkie Interface"
PROJECT_BRIEF          = "Zephyr firmware for the Nucleo-F411RE with an app-owned USART1 MIDI transport, USB MIDI device support, CD4067 mux scanning, PCA9685 LED outputs, flash-backed preset storage, startup-slot metadata, and UI_BLOCK-based ADSR/FLT/LED_DISP/LFO/MOD/OSC/VOL control surfaces."
OUTPUT_DIRECTORY       = app/docs/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
USE_MDFILE_AS_MAINPAGE = app/docs/mainpage.md

INPUT                  = README.md \
                         app/docs/mainpage.md \
                         app/src \
                         app/app.overlay \
                         cd4067/include \
                         cd4067/drivers
FILE_PATTERNS          = *.md \
                         *.overlay \
                         *.h \
                         *.c \
                         *.cpp
RECURSIVE              = YES
EXCLUDE_SYMBOLS        = cd4067_driver_api

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO

QUIET                  = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES

MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
INLINE_INFO            = YES
SORT_MEMBER_DOCS       = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
HAVE_DOT               = NO
